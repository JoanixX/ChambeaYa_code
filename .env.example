# Cadena de conexión asyncpg de PostgreSQL. Obligatoria: la app no arranca sin ella.
DATABASE_URL=postgresql+asyncpg://usuario:clave@host:5432/chambeaya-bd?ssl=require

# Clave de firma de los JWT. Obligatoria. Generar una aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Minutos de validez del access token (opcional, por defecto 60).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Vuelca cada sentencia SQL con sus parámetros. Dejar en false fuera de desarrollo.
SQL_ECHO=false

# URL del servicio de IA que genera embeddings y rankings (opcional).
IA_API_URL=http://localhost:8001
